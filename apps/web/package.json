{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#lib/utils.js": "./src/lib/utils.ts",
		"#lib/components/*": "./src/lib/components/*",
		"#lib/hooks/*": "./src/lib/hooks/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/prisma/schema/auth.prisma --yes",
		"db:seed": "varlock run -- bun run scripts/seed-admin.ts"
	},
	"dependencies": {
		"@prisma/client": "catalog:",
		"@svelte-plate/auth": "workspace:*",
		"@svelte-plate/db": "workspace:*",
		"@tanstack/svelte-form": "^1.33.5",
		"@varlock/vite-integration": "1.5.6",
		"better-auth": "catalog:",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.2.3",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.75.0",
		"@svelte-plate/config": "workspace:*",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8"
	},
	"engines": {
		"node": ">=22.17.0"
	}
}
