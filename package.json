{
  "name": "svelte-plate",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^6.0.3",
      "varlock": "1.25.0",
      "@prisma/client": "^7.10.1",
      "better-auth": "1.7.22"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @svelte-plate/db --",
    "db:studio": "turbo run db:studio -F @svelte-plate/db --",
    "db:seed": "cd apps/web && varlock run -- bun run scripts/seed-admin.ts",
    "db:generate": "turbo run db:generate -F @svelte-plate/db --",
    "db:migrate": "turbo run db:migrate -F @svelte-plate/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && bun run auth:generate"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@svelte-plate/config": "workspace:*",
    "@types/node": "^26.6.6",
    "turbo": "^2.11.11",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
